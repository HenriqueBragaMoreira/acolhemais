{
  "name": "acolhemais",
  "private": true,
  "description": "Acolhe+ — plataforma open source de adoção para ONGs e protetores de animais",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @acolhemais/e2e test:e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "node node_modules/rimraf/dist/esm/bin.mjs --glob \"{apps,packages}/*/{node_modules,dist,.next,.turbo,.wrangler,out,coverage,playwright-report,test-results}\" \"{apps,packages}/*/*.tsbuildinfo\" .turbo node_modules",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @acolhemais/db db:generate",
    "db:migrate": "pnpm --filter @acolhemais/db db:migrate",
    "db:seed": "pnpm --filter @acolhemais/db db:seed",
    "auth:generate": "pnpm --filter @acolhemais/db auth:generate",
    "auth:create-admin": "pnpm --filter @acolhemais/api auth:create-admin",
    "auth:superadmin": "pnpm --filter @acolhemais/api auth:superadmin"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
