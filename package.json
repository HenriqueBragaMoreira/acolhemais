{
  "name": "acolhemais",
  "private": true,
  "description": "Acolhe+ — plataforma open source de adoção para ONGs e protetores de animais",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --deny-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
