{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "packages/db/migrations/",
    ".next/",
    "dist/",
    "coverage/",
    ".agents/skills/",
    ".claude/skills/",
    "skills-lock.json",
    "apps/web/.impeccable/"
  ]
}
