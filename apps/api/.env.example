WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001

# Em localhost a API usa um segredo fixo de desenvolvimento. Fora dele é obrigatório
# (gere com `pnpm dlx auth@latest secret`; em produção, use `wrangler secret put`).
# BETTER_AUTH_SECRET=

# Login com Google (opcional): sem as duas variáveis, o login com Google fica desligado.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
