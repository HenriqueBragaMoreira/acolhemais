WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001

# Em localhost a API usa um segredo fixo de desenvolvimento. Fora dele é obrigatório
# (gere com `pnpm dlx auth@latest secret`; em produção, use `wrangler secret put`).
# BETTER_AUTH_SECRET=

# E-mail: sem RESEND_API_KEY, os e-mails vão para o Mailpit do docker compose
# (http://localhost:8025). Fora de localhost, RESEND_API_KEY e EMAIL_FROM são obrigatórios.
# RESEND_API_KEY=
# EMAIL_FROM=nao-responda@seu-dominio
# MAILPIT_URL=http://localhost:8025

# Login com Google (opcional): sem as duas variáveis, o login com Google fica desligado.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
