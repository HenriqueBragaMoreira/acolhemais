{
  "name": "@acolhemais/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./access": "./src/auth/access.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "auth:create-admin": "auth create-admin --config src/auth/cli.ts"
  },
  "dependencies": {
    "@acolhemais/db": "workspace:*",
    "@acolhemais/domain": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@better-auth/i18n": "1.7.18",
    "better-auth": "1.7.18",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@acolhemais/config": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "auth": "1.7.18",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
